# Copier vers .env et ajuster si besoin.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/dofusbuilder

# JWT (obligatoire en prod : secret fort et unique)
JWT_SECRET=dev-only-change-me-use-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ETL dofusdu.de : langue des noms d’objets / panoplies (en, fr, de, es, pt). Défaut : fr.
# DOFUSDU_LOCALE=fr

# CORS frontend origins (URLs séparées par des virgules)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dofus-builder.vercel.app

# URL du frontend (liens dans les emails de réinitialisation)
FRONTEND_URL=http://localhost:3000

# URL publique du site (métadonnées Open Graph / Discord). Côté frontend : NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_SITE_URL=https://zaaap.vercel.app

# Réinitialisation mot de passe (durée du lien en minutes)
# PASSWORD_RESET_EXPIRE_MINUTES=60

# SMTP — laisser SMTP_HOST vide en dev : le lien est loggé dans la console uvicorn
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@zaap-builder.vercel.app
# SMTP_FROM_NAME=Zaap Builder
# SMTP_USE_TLS=true

# Solver (optionnel) — bases PA/PM du personnage hors équipement ; limites de recherche
# CHARACTER_BASE_PA=6
# CHARACTER_BASE_PM=3
# SOLVER_MAX_CANDIDATES_PER_SLOT=250
# SOLVER_TIME_LIMIT_SECONDS=30
